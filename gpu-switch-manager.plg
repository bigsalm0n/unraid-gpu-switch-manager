<?xml version='1.0' encoding='utf-8'?>
<PLUGIN name="gpu-switch-manager" author="GPU Switch Manager contributors" version="2026.11.27.0004" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/main/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.4

Source commit `1b53e50abcb240d372d6776129afabd69027d2ab`. Unraid package version `2026.11.27.0004`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Update the install URL to v2026.11.27-rc.2 (`b58873cd99be`)
- Bootstrap a private Python runtime on Unraid when needed (`fba9835eddc9`)
- Declare Bash for the manifest script lint checks (`bb021712e0aa`)
- Exercise the updated manifest and hook entry points in package tests (`be38c77bac4c`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.4.txz" Type="base64"><INLINE></INLINE><SHA256>773f3c541cf5637a6e78d8c364595d6a6e04d0d91c9fe58e5744dc37ccd208be</SHA256></FILE><FILE Run="/bin/bash"><INLINE># shellcheck shell=bash
set -euo pipefail
package='/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.4.txz'
printf '%s  %s\n' '773f3c541cf5637a6e78d8c364595d6a6e04d0d91c9fe58e5744dc37ccd208be' "$package" | sha256sum -c -
stage=$(mktemp -d)
download=''
cleanup() {
    rm -rf -- "$stage"
    if [[ -n $download ]]; then rm -f -- "$download"; fi
}
trap cleanup EXIT
tar -xJf "$package" -C "$stage"
lib="$stage/usr/local/lib/gpu-switch-manager"
# shellcheck source=runtime/python-env
source "$lib/python-env"

if ! select_python "$lib"; then
    if [[ $(uname -m) != x86_64 ]]; then
        echo "GPU Switch Manager needs Python 3.9+ on this architecture." &gt;&amp;2
        exit 1
    fi
    asset='cpython-3.13.18+20261124-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz'
    checksum='b56ceb4fc1d8f0c49b7bd4dc91cd176bad7b86a88b9fc509bae6b10b3ee36692'
    cache="$(dirname "$package")/python-runtime.tar.gz"
    if ! printf '%s  %s\n' "$checksum" "$cache" | sha256sum -c --status 2&gt;/dev/null; then
        echo "Downloading GPU Switch Manager's private Python runtime..."
        download=$(mktemp "$cache.XXXXXX")
        curl --fail --location --silent --show-error --retry 3 --connect-timeout 15 --max-time 180 \
            "https://github.com/astral-sh/python-build-standalone/releases/download/20261124/$asset" -o "$download"
        printf '%s  %s\n' "$checksum" "$download" | sha256sum -c -
        mv -f -- "$download" "$cache"
        download=''
    fi
    # Verify a staged copy so extraction uses the exact bytes just checked.
    cp -- "$cache" "$stage/python.tar.gz"
    printf '%s  %s\n' "$checksum" "$stage/python.tar.gz" | sha256sum -c -
    tar -xzf "$stage/python.tar.gz" --no-same-owner -C "$stage"
    # The installer tracks regular files. Materialize the archive's internal aliases.
    cp -aL -- "$stage/python" "$lib/python"
    if ! select_python "$lib"; then
        echo "GPU Switch Manager could not start its private Python runtime." &gt;&amp;2
        exit 1
    fi
fi
"$python" -EB "$lib/install.py" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE># shellcheck shell=bash
set -eu
lib=/usr/local/lib/gpu-switch-manager
# shellcheck source=runtime/python-env
source "$lib/python-env"
if ! select_python "$lib"; then
    echo "GPU Switch Manager requires Python 3.9+ to remove its files and hook." &gt;&amp;2
    exit 1
fi
if [[ $python == "$lib/python/bin/python3" ]]; then
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    # Keep the interpreter available while the installer deletes the live copy.
    cp -a -- "$lib/python" "$stage/"
    python="$stage/python/bin/python3"
fi
"$python" -EB "$lib/install.py" remove
package='/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.4.txz'
rm -f -- "$package" "$(dirname "$package")/python-runtime.tar.gz"
</INLINE></FILE></PLUGIN>