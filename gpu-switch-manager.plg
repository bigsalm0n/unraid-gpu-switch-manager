<PLUGIN name="gpu-switch-manager" author="bigsalmon" version="2026.11.27.0013" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" support="https://github.com/bigsalm0n/unraid-gpu-switch-manager" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/release-installer/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.13

Source commit `b6a8b1af78d7f92776bf3fb0554860e0f9203607`. Unraid package version `2026.11.27.0013`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Allow native VM starts without PCI devices when a sharing profile is saved (`ae9115c8da50`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.13.txz" Type="base64"><INLINE></INLINE><SHA256>608f626ec7a434d700d05feb3c27b3673e8751e5c9219093c283684233ec3065</SHA256></FILE><FILE Run="/bin/bash"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
/usr/bin/php -d auto_prepend_file=none -r 'if (PHP_VERSION_ID &lt; 80100) {fwrite(STDERR, "GPU Switch Manager requires PHP 8.1 or newer.\n"); exit(1);}'
printf '%s  %s\n' '608f626ec7a434d700d05feb3c27b3673e8751e5c9219093c283684233ec3065' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.13.txz' | sha256sum -c -
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.13.txz' -C "$stage"
/usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
if [[ -f /usr/local/lib/gpu-switch-manager/install.php ]]; then
    /usr/bin/php -d auto_prepend_file=none /usr/local/lib/gpu-switch-manager/install.php remove
elif [[ -f '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.13.txz' ]]; then
    printf '%s  %s\n' '608f626ec7a434d700d05feb3c27b3673e8751e5c9219093c283684233ec3065' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.13.txz' | sha256sum -c -
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.13.txz' -C "$stage"
    /usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" remove
elif [[ -e /boot/config/plugins/gpu-switch-manager/hook-registered || -e /etc/libvirt/hooks/qemu.d/60-gpu-switch-manager ]]; then
    echo 'GPU Switch Manager runtime and cached package are missing. Reinstall this version before removing its hook.' &gt;&amp;2
    exit 1
fi
rm -f -- '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.13.txz'
</INLINE></FILE></PLUGIN>