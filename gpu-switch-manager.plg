<?xml version='1.0' encoding='utf-8'?>
<PLUGIN name="gpu-switch-manager" author="bigsalmon" version="2026.11.27.0006" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" support="https://github.com/bigsalm0n/unraid-gpu-switch-manager" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/main/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.6

Source commit `0209e9a429e2348e149843b90b3e25b930e0c782`. Unraid package version `2026.11.27.0006`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Update the install URL to v2026.11.27-rc.2 (`b58873cd99be`)
- Run GPU Switch Manager on native Unraid PHP and restore dashboard access (`07cdb203b820`)
- Detect DRM workloads when the host omits control device nodes (`0209e9a429e2`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.6.txz" Type="base64"><INLINE></INLINE><SHA256>a5256f854df2704645a93bd191e936710243b8f7d033ea20c942bb052f26a7a8</SHA256></FILE><FILE Run="/bin/bash"><INLINE>
set -euo pipefail
/usr/bin/php -d auto_prepend_file=none -r 'if (PHP_VERSION_ID &lt; 80100) {fwrite(STDERR, "GPU Switch Manager requires PHP 8.1 or newer.\n"); exit(1);}'
printf '%s  %s\n' 'a5256f854df2704645a93bd191e936710243b8f7d033ea20c942bb052f26a7a8' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.6.txz' | sha256sum -c -
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.6.txz' -C "$stage"
/usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE>
set -euo pipefail
if [[ -f /usr/local/lib/gpu-switch-manager/install.php ]]; then
    /usr/bin/php -d auto_prepend_file=none /usr/local/lib/gpu-switch-manager/install.php remove
elif [[ -f '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.6.txz' ]]; then
    printf '%s  %s\n' 'a5256f854df2704645a93bd191e936710243b8f7d033ea20c942bb052f26a7a8' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.6.txz' | sha256sum -c -
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.6.txz' -C "$stage"
    /usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" remove
elif [[ -e /boot/config/plugins/gpu-switch-manager/hook-registered || -e /etc/libvirt/hooks/qemu.d/60-gpu-switch-manager ]]; then
    echo 'GPU Switch Manager runtime and cached package are missing. Reinstall this version before removing its hook.' &gt;&amp;2
    exit 1
fi
rm -f -- '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.6.txz'
</INLINE></FILE></PLUGIN>