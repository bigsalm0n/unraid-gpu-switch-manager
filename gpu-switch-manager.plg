<?xml version='1.0' encoding='utf-8'?>
<PLUGIN name="gpu-switch-manager" author="bigsalmon" version="2026.11.27.0010" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" support="https://github.com/bigsalm0n/unraid-gpu-switch-manager" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/release-installer/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.10

Source commit `a6b239f73d2b112a6dde99a3590ea50bdcf0bcb7`. Unraid package version `2026.11.27.0010`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Support unbound GPU audio and surface VM start refusals (`21d3aee4f19b`)
- Show GPU Switch Manager under Settings User Utilities (`0015a10dee08`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.10.txz" Type="base64"><INLINE></INLINE><SHA256>8cbb2f2f3e76ad47afde08388a39af91b39573d37f3873fdf3a08e57be2c6ad1</SHA256></FILE><FILE Run="/bin/bash"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
/usr/bin/php -d auto_prepend_file=none -r 'if (PHP_VERSION_ID &lt; 80100) {fwrite(STDERR, "GPU Switch Manager requires PHP 8.1 or newer.\n"); exit(1);}'
printf '%s  %s\n' '8cbb2f2f3e76ad47afde08388a39af91b39573d37f3873fdf3a08e57be2c6ad1' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.10.txz' | sha256sum -c -
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.10.txz' -C "$stage"
/usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
if [[ -f /usr/local/lib/gpu-switch-manager/install.php ]]; then
    /usr/bin/php -d auto_prepend_file=none /usr/local/lib/gpu-switch-manager/install.php remove
elif [[ -f '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.10.txz' ]]; then
    printf '%s  %s\n' '8cbb2f2f3e76ad47afde08388a39af91b39573d37f3873fdf3a08e57be2c6ad1' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.10.txz' | sha256sum -c -
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.10.txz' -C "$stage"
    /usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" remove
elif [[ -e /boot/config/plugins/gpu-switch-manager/hook-registered || -e /etc/libvirt/hooks/qemu.d/60-gpu-switch-manager ]]; then
    echo 'GPU Switch Manager runtime and cached package are missing. Reinstall this version before removing its hook.' &gt;&amp;2
    exit 1
fi
rm -f -- '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.10.txz'
</INLINE></FILE></PLUGIN>