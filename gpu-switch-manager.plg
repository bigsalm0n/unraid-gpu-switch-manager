<PLUGIN name="gpu-switch-manager" author="bigsalmon" version="2026.11.27.0014" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" support="https://github.com/bigsalm0n/unraid-gpu-switch-manager" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/release-installer/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.14

Source commit `5c6453ba08c6a65ea2cc9b610394e0024a1e4851`. Unraid package version `2026.11.27.0014`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Stop only workloads with open handles on the shared GPU and their dependents (`886190f53261`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.14.txz" Type="base64"><INLINE></INLINE><SHA256>9bc34dd487350cc04e12d92f7c8eab6aa1aa95b07e19bbcfeb1d963da831e386</SHA256></FILE><FILE Run="/bin/bash"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
/usr/bin/php -d auto_prepend_file=none -r 'if (PHP_VERSION_ID &lt; 80100) {fwrite(STDERR, "GPU Switch Manager requires PHP 8.1 or newer.\n"); exit(1);}'
printf '%s  %s\n' '9bc34dd487350cc04e12d92f7c8eab6aa1aa95b07e19bbcfeb1d963da831e386' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.14.txz' | sha256sum -c -
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.14.txz' -C "$stage"
/usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
if [[ -f /usr/local/lib/gpu-switch-manager/install.php ]]; then
    /usr/bin/php -d auto_prepend_file=none /usr/local/lib/gpu-switch-manager/install.php remove
elif [[ -f '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.14.txz' ]]; then
    printf '%s  %s\n' '9bc34dd487350cc04e12d92f7c8eab6aa1aa95b07e19bbcfeb1d963da831e386' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.14.txz' | sha256sum -c -
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.14.txz' -C "$stage"
    /usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" remove
elif [[ -e /boot/config/plugins/gpu-switch-manager/hook-registered || -e /etc/libvirt/hooks/qemu.d/60-gpu-switch-manager ]]; then
    echo 'GPU Switch Manager runtime and cached package are missing. Reinstall this version before removing its hook.' &gt;&amp;2
    exit 1
fi
rm -f -- '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.14.txz'
</INLINE></FILE></PLUGIN>