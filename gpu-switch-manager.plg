<PLUGIN name="gpu-switch-manager" author="bigsalmon" version="2026.11.27.0012" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" support="https://github.com/bigsalm0n/unraid-gpu-switch-manager" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/release-installer/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.12

Source commit `b87609fe0c6087bc334464caf1ccec777c3d1eaf`. Unraid package version `2026.11.27.0012`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Document first-time setup, manual testing and recovery (`3cf4ec66105a`)
- Explain open GPU handles and the startup container dropdown (`2013d6743309`)
- Separate open GPU handles from possible access and clarify VM controls (`81d1e50bdff1`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.12.txz" Type="base64"><INLINE></INLINE><SHA256>38ea8f8ca7355772b25fe2c91243fca51b03c7d48ad132dd578fc766b270920b</SHA256></FILE><FILE Run="/bin/bash"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
/usr/bin/php -d auto_prepend_file=none -r 'if (PHP_VERSION_ID &lt; 80100) {fwrite(STDERR, "GPU Switch Manager requires PHP 8.1 or newer.\n"); exit(1);}'
printf '%s  %s\n' '38ea8f8ca7355772b25fe2c91243fca51b03c7d48ad132dd578fc766b270920b' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.12.txz' | sha256sum -c -
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.12.txz' -C "$stage"
/usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
if [[ -f /usr/local/lib/gpu-switch-manager/install.php ]]; then
    /usr/bin/php -d auto_prepend_file=none /usr/local/lib/gpu-switch-manager/install.php remove
elif [[ -f '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.12.txz' ]]; then
    printf '%s  %s\n' '38ea8f8ca7355772b25fe2c91243fca51b03c7d48ad132dd578fc766b270920b' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.12.txz' | sha256sum -c -
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.12.txz' -C "$stage"
    /usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" remove
elif [[ -e /boot/config/plugins/gpu-switch-manager/hook-registered || -e /etc/libvirt/hooks/qemu.d/60-gpu-switch-manager ]]; then
    echo 'GPU Switch Manager runtime and cached package are missing. Reinstall this version before removing its hook.' &gt;&amp;2
    exit 1
fi
rm -f -- '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.12.txz'
</INLINE></FILE></PLUGIN>