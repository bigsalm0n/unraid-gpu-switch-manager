<PLUGIN name="gpu-switch-manager" author="bigsalmon" version="2026.11.27.0011" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" support="https://github.com/bigsalm0n/unraid-gpu-switch-manager" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/release-installer/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.11

Source commit `607e57dac1beaab5cf22b5a6b764487afa5036a7`. Unraid package version `2026.11.27.0011`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Show detected GPU workloads and start host services with a VM (`ca801ff447da`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.11.txz" Type="base64"><INLINE></INLINE><SHA256>cf0c01c86ad303a1b433ba960d50a84a247811b608c34f99fafa99c2735a5376</SHA256></FILE><FILE Run="/bin/bash"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
/usr/bin/php -d auto_prepend_file=none -r 'if (PHP_VERSION_ID &lt; 80100) {fwrite(STDERR, "GPU Switch Manager requires PHP 8.1 or newer.\n"); exit(1);}'
printf '%s  %s\n' 'cf0c01c86ad303a1b433ba960d50a84a247811b608c34f99fafa99c2735a5376' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.11.txz' | sha256sum -c -
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.11.txz' -C "$stage"
/usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
if [[ -f /usr/local/lib/gpu-switch-manager/install.php ]]; then
    /usr/bin/php -d auto_prepend_file=none /usr/local/lib/gpu-switch-manager/install.php remove
elif [[ -f '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.11.txz' ]]; then
    printf '%s  %s\n' 'cf0c01c86ad303a1b433ba960d50a84a247811b608c34f99fafa99c2735a5376' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.11.txz' | sha256sum -c -
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.11.txz' -C "$stage"
    /usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" remove
elif [[ -e /boot/config/plugins/gpu-switch-manager/hook-registered || -e /etc/libvirt/hooks/qemu.d/60-gpu-switch-manager ]]; then
    echo 'GPU Switch Manager runtime and cached package are missing. Reinstall this version before removing its hook.' &gt;&amp;2
    exit 1
fi
rm -f -- '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.11.txz'
</INLINE></FILE></PLUGIN>