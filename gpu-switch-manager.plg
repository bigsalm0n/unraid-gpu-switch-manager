<?xml version='1.0' encoding='utf-8'?>
<PLUGIN name="gpu-switch-manager" author="bigsalmon" version="2026.11.27.0008" min="6.12.0" launch="Settings/GPUSwitchManager" icon="icon-hardware" support="https://github.com/bigsalm0n/unraid-gpu-switch-manager" pluginURL="https://raw.githubusercontent.com/bigsalm0n/unraid-gpu-switch-manager/release-installer/gpu-switch-manager.plg"><CHANGES># Release candidate 2026.11.27-rc.8

Source commit `eb340bd0c21ee0fe00878d993e572b297ff6869f`. Unraid package version `2026.11.27.0008`.

Hardware acceptance is pending. See docs/TESTING.md for the hardware procedure.

## Changes

- Update the install URL to v2026.11.27-rc.4 (`a63b30517cb1`)
- Run GPU Switch Manager on native Unraid PHP and restore dashboard access (`07cdb203b820`)
- Detect DRM workloads when the host omits control device nodes (`0209e9a429e2`)
- Update the install URL to v2026.11.27-rc.6 (`9dfb424b4e17`)
- Fix Unraid upgrade rollback storage and publish candidates after main merges (`bc8cc47e0456`)
</CHANGES><FILE Name="/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.8.txz" Type="base64"><INLINE></INLINE><SHA256>95904735ee24696ae8d46a55558c0ecc45b7a9f8c2800af422c3173188175f6b</SHA256></FILE><FILE Run="/bin/bash"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
/usr/bin/php -d auto_prepend_file=none -r 'if (PHP_VERSION_ID &lt; 80100) {fwrite(STDERR, "GPU Switch Manager requires PHP 8.1 or newer.\n"); exit(1);}'
printf '%s  %s\n' '95904735ee24696ae8d46a55558c0ecc45b7a9f8c2800af422c3173188175f6b' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.8.txz' | sha256sum -c -
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.8.txz' -C "$stage"
/usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" install
</INLINE></FILE><FILE Run="/bin/bash" Method="remove"><INLINE>
set -euo pipefail
exec 2&gt;&amp;1
if [[ -f /usr/local/lib/gpu-switch-manager/install.php ]]; then
    /usr/bin/php -d auto_prepend_file=none /usr/local/lib/gpu-switch-manager/install.php remove
elif [[ -f '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.8.txz' ]]; then
    printf '%s  %s\n' '95904735ee24696ae8d46a55558c0ecc45b7a9f8c2800af422c3173188175f6b' '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.8.txz' | sha256sum -c -
    stage=$(mktemp -d)
    trap 'rm -rf -- "$stage"' EXIT
    tar -xJf '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.8.txz' -C "$stage"
    /usr/bin/php -d auto_prepend_file=none "$stage/usr/local/lib/gpu-switch-manager/install.php" remove
elif [[ -e /boot/config/plugins/gpu-switch-manager/hook-registered || -e /etc/libvirt/hooks/qemu.d/60-gpu-switch-manager ]]; then
    echo 'GPU Switch Manager runtime and cached package are missing. Reinstall this version before removing its hook.' &gt;&amp;2
    exit 1
fi
rm -f -- '/boot/config/plugins/gpu-switch-manager/gpu-switch-manager-2026.11.27-rc.8.txz'
</INLINE></FILE></PLUGIN>