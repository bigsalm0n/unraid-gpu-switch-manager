#!/usr/bin/env python3
"""Unraid GPU Switch Manager CLI. Emits JSON except when invoked as a hook."""
import argparse
import copy
import filecmp
import hashlib
import json
import os
import shutil
from pathlib import Path
import sys
import tempfile
import uuid
import xml.etree.ElementTree as ET
from xml.dom import minidom

sys.dont_write_bytecode = True
from hardware import command
from lifecycle import Manager, domain, running
from model import DEFAULT, NAME, PCI, VM, Refused, match, read, require, validate, write

HOOK = Path("/etc/libvirt/hooks/qemu.d/60-gpu-switch-manager")
HOOK_TARGET = "/usr/local/lib/gpu-switch-manager/qemu-hook"


def virsh(*args):
    timeout = 180 if args[0] in ("start", "create", "destroy") else 15
    return command("virsh", "-c", "qemu:///system", *args, timeout=timeout)


def argument_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    cmds = parser.add_subparsers(dest="action", required=True)
    for action in ("discover", "status", "diagnostics", "export", "logs", "progress", "probe", "init", "array-stop", "array-start", "array-starting"):
        cmds.add_parser(action)
    p = cmds.add_parser("enroll")
    p.add_argument("key")
    p.add_argument("pci")
    p.add_argument("role", choices=("protected", "shared"))
    p = cmds.add_parser("import", help="Read complete version 2 configuration from stdin")
    p.add_argument("--revision")
    for action in ("assign", "dry-run", "start", "shutdown"):
        cmds.add_parser(action).add_argument("vm")
    cmds.add_parser("recover").add_argument("gpu")
    p = cmds.add_parser("hook")
    for arg in ("vm", "event", "phase"):
        p.add_argument(arg)
    return parser


def revision(cfg):
    return hashlib.sha256(json.dumps(cfg, sort_keys=True).encode()).hexdigest()


def sys_status(m):
    cfg = m.s.cfg()
    devices = m.hw.discover()
    errors, vms = [], []
    try:
        workloads = m.hw.containers()
    except (Refused, ValueError) as e:
        workloads = None
        errors.append(str(e))
    try:
        vms = virsh("list", "--all", "--name").splitlines()
    except Refused as e:
        errors.append(str(e))
    active = {}
    try:
        for uid in virsh("list", "--uuid").split():
            owner, _, devices_used = domain(virsh("dumpxml", uid))
            for addr in devices_used:
                active[addr] = owner
    except (Refused, ET.ParseError) as e:
        errors.append(str(e))
    history = m.s.run / "history.json"
    logs = read(history) if history.exists() else []
    leases = {}
    for p in m.s.leases.glob("*.json"):
        try:
            leases[p.stem] = m.lease(p.stem, cfg)
        except (Refused, ValueError, KeyError, TypeError, OSError) as e:
            leases[p.stem] = {"state": "ERROR", "message": "Invalid transaction: " + str(e)}
            errors.append(f"Inspect {p.name}: {e}")
    for data in devices:
        pci = data["pci"]
        key = next((k for k, g in cfg["gpus"].items() if g["pci"] == pci), None)
        lease = leases.get(key)
        enrolled = cfg["gpus"].get(key, {})
        data.update(key=key, protected=enrolled.get("protected", False), enrolled_uuid=enrolled.get("uuid"),
                    owner=active.get(pci), transaction=lease, clients=None, containers=None,
                    last=next((l for l in reversed(logs) if key and l["gpu"] == key), None))
        driver = data["drivers"][pci]
        data["state"] = lease["state"] if lease else ("VFIO_BOUND" if driver == "vfio-pci" else "HOST_AVAILABLE")
        if driver and driver != "vfio-pci" and not data["error"]:
            try:
                clients = m.hw.clients(data)
                data["clients"] = clients
                if workloads is not None:
                    found = m.hw.assignments(data, workloads, clients)
                    data["containers"] = {n: reasons for n, reasons in found.items() if running(workloads[n])}
                if not lease and clients:
                    data["state"] = "HOST_IN_USE"
            except (Refused, OSError) as e:
                data["error"] = str(e)
        if (enrolled and enrolled["functions"] != data["functions"]) or (
                enrolled.get("uuid") and driver != "vfio-pci" and enrolled["uuid"] != data["uuid"]):
            data["error"] = "Enrolled identity differs; verify and remap"
        if data["error"] or not driver:
            data["state"] = "ERROR"
    release = Path(__file__).with_name("release.json")
    return dict(devices=devices, errors=errors, config=cfg, revision=revision(cfg), transactions=leases,
                release=read(release) if release.is_file() else None,
                containers=None if workloads is None else sorted(workloads), vms=[v for v in vms if v],
                hook_installed=HOOK.is_file() and os.access(HOOK, os.X_OK) and filecmp.cmp(HOOK, HOOK_TARGET, shallow=False),
                array_stopping=(m.s.run / "array-stopping").exists())


def proof(m):
    """A unique hardware-free domain is vetoed by our prepare hook."""
    uid = str(uuid.uuid4())
    name = "gsm-probe-" + uid
    xml = f"<domain type='kvm'><name>{name}</name><uuid>{uid}</uuid><memory unit='MiB'>128</memory><vcpu>1</vcpu><os><type arch='x86_64'>hvm</type></os><devices/></domain>"
    marker = m.s.run / name
    with m.s.lock("probe"):
        marker.write_text(uid)
        try:
            with tempfile.NamedTemporaryFile(mode="w", dir=m.s.run, suffix=".xml") as spec:
                spec.write(xml)
                spec.flush()
                try:
                    virsh("create", spec.name, "--paused")
                except Refused:
                    require(marker.read_text() == "observed", "Libvirt did not invoke this plugin's prepare hook")
                    return {"verified": True, "event": "prepare/begin"}
                try:
                    virsh("destroy", uid)
                except Refused as e:
                    raise Refused(f"Inspect paused probe {name} ({uid}); cleanup failed: {e}") from e
                raise Refused("Probe reached paused startup; hook is inactive. Check libvirt hook registration.")
        finally:
            marker.unlink(missing_ok=True)


def assign(m, cfg, key, vm, uid):
    with m.s.lock("definition-" + uid):
        require(not m.lease(key, cfg), "GPU has an outstanding transaction")
        data = m.target(cfg, key)
        require(virsh("domstate", uid).strip() == "shut off", "Shut down the selected VM before changing its definition")
        original = virsh("dumpxml", "--inactive", "--security-info", uid)
        name, identity, devices = domain(original)
        require((name, identity) == (vm, uid), "VM definition changed")
        require(devices.keys() <= data["drivers"].keys() and all(devices.values()), "Review conflicting PCI hostdev entries in the VM editor")
        m.guard(cfg, vm, dict.fromkeys(data["drivers"], True))
        if devices.keys() != data["drivers"].keys():
            doc = minidom.parseString(original)
            parent = next(n for n in doc.documentElement.childNodes if n.nodeName == "devices")
            for addr in sorted(data["drivers"].keys() - devices.keys()):
                dev = doc.createElement("hostdev")
                for k, v in (("mode", "subsystem"), ("type", "pci"), ("managed", "yes")):
                    dev.setAttribute(k, v)
                driver = doc.createElement("driver")
                driver.setAttribute("name", "vfio")
                dev.appendChild(driver)
                source = doc.createElement("source")
                address = doc.createElement("address")
                for k, v in zip(("domain", "bus", "slot", "function"), (addr[:4], addr[5:7], addr[8:10], addr[11:])):
                    address.setAttribute(k, "0x" + v)
                source.appendChild(address)
                dev.appendChild(source)
                parent.appendChild(dev)
            with tempfile.NamedTemporaryFile(dir=m.s.run, suffix=".xml") as spec:
                spec.write(doc.toxml(encoding="utf-8"))
                spec.flush()
                require(original == virsh("dumpxml", "--inactive", "--security-info", uid)
                        and virsh("domstate", uid).strip() == "shut off", "VM changed while editing; refresh")
                virsh("define", "--validate", spec.name)
        result = domain(virsh("dumpxml", "--inactive", uid))
        require(result == (vm, uid, dict.fromkeys(data["drivers"], True)), "Persistent hostdev verification failed")
        return {"vm": vm, "managed_devices": sorted(result[2])}


def recovery(m, key):
    cfg = m.s.cfg()
    require(key in cfg["gpus"], "Unknown GPU")
    before = m.lease(key, cfg)
    if not before:
        return {"pending": False}
    # libvirt may be waiting for a hook. Never hold a per-GPU lock during these calls.
    if before["domain"] in virsh("list", "--all", "--uuid").split():
        require(virsh("domstate", before["domain"]).strip() == "shut off", "Owner domain is not shut off")
        try:
            job = virsh("domjobinfo", before["domain"])
        except Refused as e:
            if "domain is not running" not in str(e):
                raise
        else:
            require(any(line.split(":", 1)[-1].strip() == "None" for line in job.splitlines() if line.startswith("Job type:")),
                    "Owner domain has a pending libvirt job")
    for uid in virsh("list", "--uuid").split():
        _, _, devices = domain(virsh("dumpxml", uid))
        require(uid != before["domain"] and not set(devices).intersection(before["drivers"]), "A running domain still owns this assignment")
    with m.s.lock("gpu-" + key):
        j = m.lease(key, cfg)
        require(j == before, "Transaction changed during reconciliation; refresh diagnostics")
        m.restore(key, j)
    return {"restored": key}


def dispatch(m, args):
    action = args.action
    if action == "hook":
        xml = sys.stdin.buffer.read(4 * 1024 * 1024 + 1)
        if args.vm.startswith("gsm-probe-") and match(args.vm, NAME) and (args.event, args.phase) == ("prepare", "begin"):
            marker = m.s.run / args.vm
            if marker.exists() and marker.read_text() == domain(xml)[1]:
                marker.write_text("observed")
                raise Refused("GPU manager hook probe observed")
        return m.hook(args.vm, args.event, args.phase, xml)
    if action == "discover":
        return m.hw.discover()
    if action == "probe":
        return proof(m)
    if action == "progress":
        return {p.stem: read(p) for p in m.s.leases.glob("*.json") if p.exists()}
    if action in ("status", "diagnostics"):
        report = sys_status(m)
        if action == "diagnostics":
            report["commands"] = {name: shutil.which(name) for name in ("docker", "virsh", "lspci", "nvidia-smi")}
            report["kernel"] = os.uname().release
            report["unresolved"] = [key for key, gpu in report["config"]["gpus"].items()
                                    if not any(d["pci"] == gpu["pci"] for d in report["devices"])]
        return report
    if action == "logs":
        p = m.s.run / "history.json"
        return read(p) if p.exists() else []
    if action == "array-stop":
        (m.s.run / "array-stopping").touch()
        return {"stopping": True}
    if action in ("array-start", "array-starting"):
        (m.s.run / "array-stopping").unlink(missing_ok=True)
        if action == "array-starting":
            return {"stopping": False}
        results = {}
        with m.s.lock("maintenance", shared=True):
            for p in m.s.leases.glob("*.json"):
                try:
                    results[p.stem] = recovery(m, p.stem)
                except (Refused, OSError, ValueError, KeyError) as e:
                    m.s.log(p.stem, None, "DEFERRED", str(e))
                    results[p.stem] = str(e)
        return results
    if action in ("init", "import", "enroll"):
        verified = False
        if action == "import":
            raw = sys.stdin.buffer.read(262145)
            require(len(raw) <= 262144, "Configuration too large")
            cfg = validate(json.loads(raw))
            if cfg["enabled"] and not m.s.cfg()["enabled"]:
                proof(m)
                verified = True
        with m.s.lock("maintenance"):
            if action == "init":
                if not m.s.settings.exists():
                    m.s.change(copy.deepcopy(DEFAULT))
                return m.s.cfg()
            current = m.s.cfg()
            if action == "import":
                require(args.revision is None or args.revision == revision(current), "Configuration was edited; reload before saving")
                require(not cfg["enabled"] or current["enabled"] or verified, "Retry enabling after the concurrent configuration edit")
                for key, gpu in cfg["gpus"].items():
                    if current["gpus"].get(key) != gpu or (cfg["enabled"] and not current["enabled"]):
                        require(m.hw.snapshot(gpu["pci"], gpu["protected"]) == gpu, "Identity mismatch for " + key)
            else:
                require(match(args.key, NAME) and match(args.pci, PCI), "Invalid enrollment")
                cfg = copy.deepcopy(current)
                cfg["gpus"][args.key] = m.hw.snapshot(args.pci, args.role == "protected")
            m.s.change(cfg)
            return cfg
    with m.s.lock("maintenance", shared=True):
        cfg = m.s.cfg()
        if action == "export":
            return cfg
        if action == "recover":
            return recovery(m, args.gpu)
        require(match(args.vm, VM) and args.vm in cfg["profiles"], "Select a configured VM")
        key = cfg["profiles"][args.vm]["gpu"]
        xml = virsh("dumpxml", "--inactive", args.vm)
        vm, uid, devices = domain(xml)
        require(vm == args.vm, "Domain identity mismatch")
        require(str(uuid.UUID(uid)) == uid, "Invalid domain UUID")
        if action == "assign":
            proof(m)
            return assign(m, cfg, key, vm, uid)
        if action == "shutdown":
            j = m.lease(key, cfg)
            require(j and j["domain"] == uid and j["vm"] == vm and j["state"] == "VM_ACTIVE", "No matching active transaction")
            virsh("shutdown", uid)
            return {"vm": vm, "result": "Guest shutdown requested; release is pending"}
        require(virsh("domstate", uid).strip() == "shut off", "The selected VM must be shut off")
        with m.s.lock("gpu-" + key):
            m.guard(cfg, vm, devices)
            plan = m.prepare(cfg, key, vm, uid, devices, dry=True)
        if action == "dry-run":
            return plan
        require(cfg["enabled"], "Enable automatic switching before VM startup")
        proof(m)
        try:
            virsh("start", uid)
        except Refused as e:
            pending = m.lease(key, cfg)
            if pending and pending["domain"] == uid:
                try:
                    recovery(m, key)
                except (Refused, OSError, ValueError) as recovery_error:
                    raise Refused(f"{e}. Recovery pending: {recovery_error}") from e
            raise
        j = m.lease(key, cfg)
        require(j and j["domain"] == uid and j["state"] == "VM_ACTIVE" and virsh("domstate", uid).strip() == "running",
                "Start issued; verified VM_ACTIVE state unavailable. Inspect diagnostics.")
        return {"vm": vm, "result": "VM_ACTIVE"}


if __name__ == "__main__":
    args = argument_parser().parse_args()
    try:
        require(os.geteuid() == 0, "Root is required")
        manager = Manager()
        manager.s.run.mkdir(mode=0o700, exist_ok=True, parents=True)
        result = dispatch(manager, args)
        if args.action != "hook":
            print(json.dumps(result, indent=2))
    except (Refused, OSError, ValueError, KeyError, TypeError, ET.ParseError) as error:
        print(json.dumps({"error": str(error)}), file=sys.stderr)
        sys.exit(1)
