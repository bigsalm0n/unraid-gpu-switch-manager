{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPU Switch Manager configuration",
  "type": "object", "additionalProperties": false,
  "required": ["version", "enabled", "gpus", "profiles"],
  "properties": {
    "version": {"const": 2},
    "enabled": {"type": "boolean"},
    "gpus": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["pci", "uuid", "functions", "protected"],
        "properties": {
          "pci": {"type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[01][0-9a-f]\\.[0-7]$"},
          "uuid": {"type": ["string", "null"], "pattern": "^GPU-[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"},
          "protected": {"type": "boolean"},
          "functions": {"type": "object", "minProperties": 1, "maxProperties": 8, "propertyNames": {"pattern": "^[0-7]$"},
            "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{6}(:[0-9a-f]{4}){4}$"}}
        },
        "if": {"properties": {"protected": {"const": false}}},
        "then": {"properties": {"uuid": {"type": "string"}}}
      }
    },
    "profiles": {
      "type": "object", "propertyNames": {"pattern": "^[a-zA-Z0-9][a-zA-Z0-9 _.()-]{0,126}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["gpu", "containers"],
        "properties": {
          "gpu": {"$ref": "#/$defs/name"},
          "automatic": {"type": "boolean"},
          "containers": {"type": "array", "maxItems": 64, "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "policy", "after"],
            "properties": {"name": {"$ref": "#/$defs/name"}, "policy": {"enum": ["restore", "stop", "leave"]},
              "after": {"type": "array", "items": {"$ref": "#/$defs/name"}}}
          }}
        }
      }
    }
  },
  "$defs": {"name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"}}
}
